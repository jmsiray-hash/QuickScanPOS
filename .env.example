APP_NAME="QuickScanPos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-service.onrender.com
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=your-database-host
DB_PORT=3306
DB_DATABASE=your-database-name
DB_USERNAME=your-database-user
DB_PASSWORD=your-database-password
# Set to the validated VAT rate for your store; 0 keeps current non-VAT behavior.
POS_VAT_RATE=0
# Optional: set this to a Render Secret File path containing the Aiven CA certificate.
MYSQL_ATTR_SSL_CA=
# Defaults to true when a CA path is provided; set false only if your provider requires it.
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
